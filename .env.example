# 飞书应用凭证（在 https://open.feishu.cn/app 创建应用后获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude 默认配置
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_CWD=~

# 工具权限模式：bypassPermissions（跳过所有确认，推荐个人使用）
#              default（需要确认敏感操作）
PERMISSION_MODE=bypassPermissions

# （可选）Claude CLI 路径，留空则自动从 PATH 查找
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# ===== 控制层 =====
# 授权门：off=全放行（默认，向后兼容）；observe=只记录不放行；auto=仅管理员可执行
# auto 未设 ADMIN_OPEN_ID 时，第一个私聊机器人的用户会被锁定为管理员并落盘
ADMISSION_MODE=off
# 显式管理员 open_id；留空走"首个私聊者锁定"，状态在 ~/.feishu-claude/admission.json
# ADMIN_OPEN_ID=ou_xxxxxxxxxxxxxxxx
# 全局并发上限：同时最多几个 claude CLI 任务，保护本机和上游网关
MAX_CONCURRENT_RUNS=2
# 新消息是否腰斩正在跑的任务；默认 false = 排队，当前 turn 结束后作为 follow-up 继续
INTERRUPT_ON_NEW_MESSAGE=false
# 安静模式：干活时不刷工具进度/流式卡片，只在结果、失败、需要人回答时更新卡片
QUIET_MODE=false
# 飞书单条消息长度上限（超出保留尾部结果，不拆成多条刷屏）
REPLY_MAX_CHARS=1500
# 幂等表：已处理的 message_id 落盘到 ~/.feishu-claude/seen_messages.json，
# 看门狗重启后飞书重推事件不会跑两遍
SEEN_TTL=600
SEEN_MAX=2000
# SEEN_STORE_PATH=

# ===== 卡片回调 / 本地控制接口 =====
# 默认只监听本机，避免 /handover 暴露到公网
CALLBACK_HOST=127.0.0.1
# 设置后 /handover 才启用；handover.py 侧需设置同名环境变量
# CONTROL_TOKEN=CHANGE_ME
